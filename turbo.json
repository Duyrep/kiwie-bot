{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			],
			"outputs": [
				"dist/**",
				".next/**",
				"!.next/cache/**",
				"!.next/dev/**"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"discord-deploy": {
			"cache": false,
			"persistent": true
		},
		"discord-deploy:dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		}
	}
}