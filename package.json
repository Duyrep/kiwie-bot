{
	"name": "kiwie-bot",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"start": "turbo run start",
		"dev": "turbo run dev",
		"memory-test": "pnpm start",
		"discord-deploy": "turbo run discord-deploy",
		"discord-deploy:dev": "turbo run discord-deploy:dev",
		"guard": "pnpm --filter=@rep/guard",
		"logger": "pnpm --filter=@rep/logger",
		"discord-core": "pnpm --filter=@rep/discord-core",
		"discord-commands": "pnpm --filter=@rep/discord-commands",
		"format": "pnpx @biomejs/biome format --write",
		"lint": "pnpx @biomejs/biome lint --write",
		"check": "pnpx @biomejs/biome check --write"
	},
	"dependencies": {
		"@biomejs/biome": "2.5.8",
		"pino-pretty": "^13.1.3",
		"turbo": "^2.10.9"
	},
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=22"
	}
}